# ============================================================
# .gitignore — The Serverless Odyssey
# DevSecOps Standard: Next.js 16 + Supabase + Cloudinary + Vercel
# ============================================================

# ─── SECRETS & CREDENTIALS (WAJIB — JANGAN HAPUS) ───────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
service-account*.json

# ─── NEXT.JS BUILD ARTIFACTS ─────────────────────────────────
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# ─── DEPENDENCIES ────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── TESTING & COVERAGE ──────────────────────────────────────
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/

# ─── VERCEL ──────────────────────────────────────────────────
.vercel
.vercel-cache/

# ─── SUPABASE LOCAL ──────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ─── CLOUDINARY ──────────────────────────────────────────────
.cloudinary/
cloudinary_config.json

# ─── DEBUG & LOGS ────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# ─── OS TEMPORARY FILES ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── EDITOR & IDE ────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ─── TURBOPACK CACHE ─────────────────────────────────────────
.turbo/

# ─── MISC ────────────────────────────────────────────────────
*.tgz
*.zip
/dist/
